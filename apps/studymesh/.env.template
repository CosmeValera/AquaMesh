# Copy this file to `.env` in this same folder and fill real values.
# Do not commit `.env`.

# Supabase Auth + cloud sync
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Optional own-key providers. These are bundled into the browser build.
# Do not put app-owned hosted keys here.
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...

# Hosted Study Credits gateway uses server-only env vars.
# Do not put these values in this browser `.env` file.
# Set them in Vercel dashboard env vars. For local `vercel dev`, set them in
# your shell/session or a local root `.env` that is never committed:
# HOSTED_CEREBRAS_API_KEY=csk-...
# HOSTED_CEREBRAS_MODEL=gpt-oss-120b
# SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Optional local AI debug panel
VITE_SHOW_LOCAL_AI_DEBUG_PANEL=false
