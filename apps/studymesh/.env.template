# Copy this file to `.env` in this same folder and fill real values.
# Do not commit `.env`.

# Supabase Auth + cloud sync
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Optional own-key providers. These are bundled into the browser build.
# Do not put app-owned hosted keys here.
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...

# Hosted Study Credits gateway uses server-only env vars.
# Do not put these values in this browser `.env` file.
# Set them in Vercel dashboard env vars. For local `vercel dev`, set them in
# your shell/session or a local root `.env.local` that is never committed:
# HOSTED_AI_TEXT_PROVIDER=openai # openai or cerebras; defaults to cerebras
# HOSTED_OPENAI_API_KEY=sk-...
# HOSTED_OPENAI_MODEL=gpt-5.4-mini
# HOSTED_CEREBRAS_API_KEY=csk-...
# HOSTED_CEREBRAS_MODEL=gpt-oss-120b
# UNREAL_SPEECH_API_KEY=your-unreal-speech-api-key
# UNREAL_SPEECH_VOICE_ID=Sierra
# PODCAST_AUDIO_BUCKET=study-guide-podcasts # OPTIONAL
# PODCAST_TTS_MONTHLY_CHARACTER_CAP=225000 # OPTIONAL
# PODCAST_MAX_GENERATIONS_PER_USER_PER_DAY=3 # OPTIONAL
# SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
# STUDYMESH_APP_URL=https://your-studymesh-domain.example
# STUDYMESH_ALLOWED_ORIGINS=https://your-studymesh-domain.example
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_STUDY_CREDITS_PRICE_ID_2_EUR=price_...
# STRIPE_STUDY_CREDITS_PRICE_ID_5_EUR=price_...
# STRIPE_STUDY_CREDITS_PRICE_ID_10_EUR=price_...
# STRIPE_STUDY_CREDITS_PRICE_ID_20_EUR=price_...
# STRIPE_AUTOMATIC_TAX=false

# Optional local AI debug panel
VITE_SHOW_LOCAL_AI_DEBUG_PANEL=false
